# Frontend build-time configuration.
#
# Vite inlines these into the bundle at `npm run build`, so changing one needs a
# rebuild/redeploy - restarting is not enough. Only VITE_-prefixed variables are
# exposed to the browser, which also means NEVER put a secret here: anything in
# this file is readable by anyone who views the deployed page source.
#
# Local development works with no .env at all; src/config.js falls back to
# localhost:8000.

# Backend API root, including the trailing /api and no trailing slash.
VITE_API_BASE=https://odcat-api.onrender.com/api
